@@ -252,7 +276,49 @@
   nu = 1000
   nradrho = numjlm
 
-  call afold(z, a, ee, rb, nu, rva, va, radmom, rhomom, nradrho)
+  if (alphaomp == 9) then
+!
+! Atomki-V2: read the tabulated real folding potential from alphaomp9real.gnu.
+! File format (from the supplementary material of the ADNDT paper):
+!   2 header lines, 1 line with the Coulomb radius rc, then per line
+!   r [fm], V(r) [MeV] (further columns are ignored).
+!
+    open(unit = 77, file = 'alphaomp9real.gnu', status = 'old', iostat = istat)
+    if (istat /= 0) then
+      write(*, '(" TALYS-error: alphaomp 9 requires the Atomki-V2 real potential file alphaomp9real.gnu", &
+ &      " in the working directory")')
+      stop
+    endif
+    read(77, '(a)', iostat = istat) key
+    if (istat == 0) read(77, '(a)', iostat = istat) key
+    if (istat == 0) read(77, *, iostat = istat) rc_pm
+    if (istat /= 0) then
+      write(*, '(" TALYS-error: cannot read the header of alphaomp9real.gnu")')
+      stop
+    endif
+    if (rc_pm <= 0.5 .or. rc_pm >= 2.0) then
+      write(*, '(" TALYS-error: Coulomb radius in alphaomp9real.gnu out of range 0.5...2.0 fm: ", f10.5)') rc_pm
+      stop
+    endif
+    nu = 0
+    do i = 1, 1000
+      read(77, *, iostat = istat) rva(i), va(i)
+      if (istat /= 0) exit
+      nu = i
+    enddo
+    close(77)
+    if (nu < 2) then
+      write(*, '(" TALYS-error: no potential values found in alphaomp9real.gnu")')
+      stop
+    endif
+    if (rva(nu) < rb) then
+      write(*, '(" TALYS-error: alphaomp9real.gnu ends at r = ", f8.3, " fm, radial grid extends to ", f8.3, " fm")') &
+ &      rva(nu), rb
+      stop
+    endif
+  else
+    call afold(z, a, ee, rb, nu, rva, va, radmom, rhomom, nradrho)
+  endif
 !
 ! Depth and shape are multiplied by the OMP adjustment keywords of TALYS
 ! (default 1.)
@@ -275,7 +341,15 @@
 !   of the (a,g) and (a,n) data of deformed nuclei : 27/4/2018 (Brussels)
 !   increase of rva by 3% for deformed nuclei but only below typically 18 MeV
 
-    rva(i) = factor1 * aradialcor * rva(i) * (1. + abs(beta2(Zix, Nix, 0)) / 15. / (1. + exp((E - 18.) / 2.)))
+!
+! Atomki-V2: the real part is a fixed tabulated potential, so only the
+! aradialcor/adepthcor keywords apply; the deformation correction below is not.
+!
+    if (alphaomp == 9) then
+      rva(i) = factor1 * aradialcor * rva(i)
+    else
+      rva(i) = factor1 * aradialcor * rva(i) * (1. + abs(beta2(Zix, Nix, 0)) / 15. / (1. + exp((E - 18.) / 2.)))
+    endif
     va(i) = factor2 * adepthcor * va(i)
   enddo
 !
@@ -307,7 +381,7 @@
     bb1 = (rr - rva(klo)) / hh
     vopr(k) = aa1 * va(klo) + bb1 * va(khi)
 ! dispersive contributions to real potential for alphaomp=5  (OMP III)
-    if (alphaomp < 5) then
+    if (alphaomp /= 5) then
       vdiv = 0.
       vdis = 0.
     else
@@ -345,6 +419,8 @@
   enddo
 ! calculate the coulomb radius based on elton's formula
   rc = 1.123 + 2.352 * (a **( - .666666)) - 2.07 * (a **( - 1.333333))
+! Atomki-V2: Coulomb radius from the potential file
+  if (alphaomp == 9) rc = rc_pm
   200 continue
   return
 end subroutine foldalpha
