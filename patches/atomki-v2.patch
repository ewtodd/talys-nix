+  goto 50
+!
+   40 continue
+!--------------------------------------------------------------------------------------
+! Case alphaomp=9
+! Atomki-V2 potential of P. Mohr et al., At. Data Nucl. Data Tables 142, 101453 (2021)
+! The real part is read from the file alphaomp9real.gnu in the working directory
+! (see below). Imaginary potential: Woods-Saxon volume term with W0 = 50 MeV,
+! R0 = 1.0 fm, a = 0.1 fm (simulation of CCFULL), no surface term.
+!--------------------------------------------------------------------------------------
+  alphav(1) = 1.25
+  alphav(3) = 1.0
+  alphav(4) = 0.1
+  alphav(8) = 50.0
+  alphav(5) = 0.
+  dwv = 0.
+  dws = 0.
+!
    50 continue
 
